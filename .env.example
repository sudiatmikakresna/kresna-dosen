# Database Neon (diisi otomatis oleh integrasi Neon di Vercel)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Rahasia untuk cookie sesi dan enkripsi token Google (string acak minimal 32 karakter)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Kunci untuk membuat akun dosen pertama kali di /dosen/setup
SETUP_KEY=ganti-dengan-kunci-rahasia

# OAuth Client Google (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: batasi login Google ke domain kampus
GOOGLE_HD=primakara.ac.id
# Alamat produksi, dipakai untuk redirect OAuth (https://<domain>/api/google/callback)
APP_URL=https://bimbingan.example.com

# Bot Telegram untuk notifikasi berkas baru (token dari @BotFather)
TELEGRAM_BOT_TOKEN=

# Laporan review ke grup WhatsApp (WAHA di VPS)
WAHA_URL=https://waha.kresna.blog
WAHA_API_KEY=
WAHA_SESSION=default
# Kunci HMAC webhook pesan grup; sama dengan WHATSAPP_HOOK_HMAC_KEY di WAHA (openssl rand -hex 32)
WAHA_WEBHOOK_HMAC_KEY=

# Review otomatis lewat Claude API (10 menit setelah berkas diunggah, butuh APP_URL di atas) dan bot tanya-jawab grup WA
ANTHROPIC_API_KEY=
# Upstash QStash untuk jeda review (terisi otomatis bila memakai integrasi Upstash di Vercel Marketplace)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Opsional: jeda dalam menit (bawaan 10)
REVIEW_JEDA_MENIT=10
# Opsional: low | medium | high (bawaan) | xhigh
REVIEW_EFFORT=high

# MCP SISKA (/api/siska/mcp): cookie dosen SISKA, minimal remember_web_...=<nilai> (login dengan "Ingat Saya").
# Memberi akses penuh ke akun dosen; simpan hanya di environment server.
SISKA_COOKIE=
# Opsional, bawaan https://siska.primakara.ac.id
SISKA_BASE_URL=
# Bot WA: data kelas SPK dari database Turso idea-spk (opsional, token read-only:
# turso db tokens create <nama-db> --read-only)
SPK_TURSO_DATABASE_URL=
SPK_TURSO_AUTH_TOKEN=
# Bot WA: poin dan progres Bengkel Pemrograman Mobile (opsional). Neon berisi schema "bengkel" yang
# disinkron tiap 5 menit dari server Bengkel. Pakai role yang hanya punya hak SELECT.
BENGKEL_DATABASE_URL=

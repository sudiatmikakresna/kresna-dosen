# Database Neon (diisi otomatis oleh integrasi Neon di Vercel)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Rahasia untuk menandatangani cookie sesi (string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Kunci untuk membuat akun dosen pertama kali di /dosen/setup
SETUP_KEY=ganti-dengan-kunci-rahasia

# Vercel Blob (diisi otomatis saat Blob store dihubungkan ke project)
BLOB_READ_WRITE_TOKEN=
